CARTESIA_API_KEY=buraya_kendi_anahtarin
CARTESIA_VOICE=buraya_ses_id

# Kare animasyon atölyesi (isteğe bağlı AI sahne üretimi). Kare'de ⚙ Ayarlar sayfasından da düzenlenebilir.
# AI_PROVIDER: glm | openai | anthropic | gemini (boşsa anahtarı olan ilk sağlayıcı: glm → openai → anthropic → gemini)
# Not: sahne üretimi güçlü modellerle iyi sonuç verir; Haiku, GPT luna gibi çok ucuz/küçük modellerde sahneler basit/dağınık olabilir.
AI_PROVIDER=
GLM_API_KEY=
GLM_MODEL=glm-5.3
# GLM_BASE_URL boşsa https://api.z.ai/api/coding/paas/v4 (yalnızca resmi Z.ai/Bigmodel adresleri kabul edilir)
GLM_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
# Varsayılan: kararlı Flash modeli (https://ai.google.dev/gemini-api/docs/models); daha güçlü sonuç için bir Pro modeli yazılabilir
GEMINI_MODEL=gemini-3.8-flash
